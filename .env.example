# Artelivo Davet Masası — anahtarlar. Bu dosya git'e girmez.

# Artelivo (prod: https://artelivo.com, yerel deneme: http://localhost:3000)
ARTELIVO_API_URL=https://artelivo.com
# Taslak yazar/düzenler/siler. Prod .env'deki ARTIST_INVITE_AGENT_KEY ile aynı.
ARTIST_INVITE_AGENT_KEY=
# Instagram davetinin sahiplenme linkini alır. Prod .env'deki ARTIST_INVITE_LINK_KEY ile aynı.
# YALNIZ bu bilgisayarda durur; başka hiçbir yere yazma.
ARTIST_INVITE_LINK_KEY=

# Claude: bu Mac'teki Claude Code (Max planı) kullanılır — API anahtarı YOK, ek ücret yok.
# `claude` komutu yüklü ve Max hesabıyla girişli olmalı. İsteğe bağlı:
# CLAUDE_MODEL=opus
# CLAUDE_BIN=claude

# Taslak alan kuralları — varsayılan: ../artemiz/apps/web/agent/artist-invites/MAPPING.md
# MAPPING_FILE=

# E-posta daveti — artemiz apps/web/.env'deki SMTP ile aynı. Gönderen adres SMTP_USER;
# EMAIL_FROM yalnız görünen ad.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Artelivo
